{
  "class-method": {
    "description": "One class owning one method.",
    "nodes": [
      {
        "type": "CLASS",
        "fqn": { "bind": "ownerClass" }
      },
      {
        "type": "METHOD",
        "fqn": { "bind": "ownedMethod" }
      }
    ],
    "edges": [
      {
        "type": "HAS_METHOD",
        "ownerFqn": { "equalsBinding": "ownerClass" },
        "methodFqn": { "equalsBinding": "ownedMethod" }
      }
    ]
  },
  "class-field": {
    "description": "One class owning one field.",
    "nodes": [
      {
        "type": "CLASS",
        "fqn": { "bind": "ownerClass" }
      },
      {
        "type": "FIELD",
        "fqn": { "bind": "ownedField" }
      }
    ],
    "edges": [
      {
        "type": "HAS_FIELD",
        "ownerFqn": { "equalsBinding": "ownerClass" },
        "fieldFqn": { "equalsBinding": "ownedField" }
      }
    ]
  },
  "interface-implementation": {
    "description": "One interface implemented by one class.",
    "nodes": [
      {
        "type": "INTERFACE",
        "fqn": { "bind": "interface" }
      },
      {
        "type": "CLASS",
        "fqn": { "bind": "implementation" }
      }
    ],
    "edges": [
      {
        "type": "IMPLEMENTS",
        "interfaceFqn": { "equalsBinding": "interface" },
        "implementingClassFqn": { "equalsBinding": "implementation" }
      }
    ]
  },
  "inheritance": {
    "description": "One child class extending one parent class.",
    "nodes": [
      {
        "type": "CLASS",
        "fqn": { "bind": "parentClass" }
      },
      {
        "type": "CLASS",
        "fqn": { "bind": "childClass" }
      }
    ],
    "edges": [
      {
        "type": "EXTENDS",
        "parentClassFqn": { "equalsBinding": "parentClass" },
        "childClassFqn": { "equalsBinding": "childClass" }
      }
    ]
  },
  "method-call": {
    "description": "One method calling another method.",
    "nodes": [
      {
        "type": "METHOD",
        "fqn": { "bind": "callingMethod" }
      },
      {
        "type": "METHOD",
        "fqn": { "bind": "calledMethod" }
      }
    ],
    "edges": [
      {
        "type": "CALLS",
        "callingMethodFqn": { "equalsBinding": "callingMethod" },
        "calledMethodFqn": { "equalsBinding": "calledMethod" },
        "insideLoop": false,
        "insideConditional": false,
        "isConstructorCall": false
      }
    ]
  }
}
