  "singleton": {
    "metadata": {
      "patternName": "Singleton",
      "patternType": "Design Pattern",
      "description": "Creational design pattern. Ensures a class has only one instance and provides a global point of access to it.",
      "learningInfo": "Use this pattern when only one instance of a class is needed across the application."
    },
    "candidateTopologies": [
      {
        "nodes": [
          {
            "type": "CLASS",
            "fqn": { "bind": "singletonClass" }
          },
          {
            "type": "FIELD",
            "fqn": { "bind": "instanceField" },
            "typeFqn": { "equalsBinding": "singletonClass" },
            "modifiers": ["PRIVATE", "STATIC"]
          },
          {
            "type": "METHOD",
            "fqn": { "bind": "getInstanceMethod" },
            "returnTypeFqn": { "equalsBinding": "singletonClass" },
            "modifiers": ["PUBLIC", "STATIC"]
          }
        ],
        "edges": [
          {
            "type": "HAS_FIELD",
            "ownerFqn": { "equalsBinding": "singletonClass" },
            "fieldFqn": { "equalsBinding": "instanceField" }
          },
          {
            "type": "HAS_METHOD",
            "ownerFqn": { "equalsBinding": "singletonClass" },
            "methodFqn": { "equalsBinding": "getInstanceMethod" }
          }
        ]
      }
    ]
