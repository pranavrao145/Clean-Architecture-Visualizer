                    "name": "",
                    "parameterFqns": [],
                    "returnTypeFqn": "",
                    "modifiers": []
                }
            ],
            "edges": [
                {
                    "type": "HAS_METHOD",
                    "ownerFqn": "$ownerClass",
                    "methodFqn": "$conditionalMethod"
                },
                {
                    "type": "CALLS",
